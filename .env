# https://docs.expo.dev/guides/tree-shaking/
# EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1
# Currently breaking on EAS
# EXPO_UNSTABLE_TREE_SHAKING=1

# Development tools
# Set this to "true" to wipe all application data on startup (acts like a clean installation)
EXPO_PUBLIC_RESET_APP_DATA=false

# Android Development Environment Variables
# These should be set for proper Android SDK and emulator functionality

# Android SDK root directory
ANDROID_HOME=/opt/android-sdk
ANDROID_SDK_ROOT=/opt/android-sdk

# Android Virtual Device home directory
ANDROID_AVD_HOME=/root/.android/avd

# Java home directory (optional but recommended)
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Additional PATH components for Android tools
# Note: PATH modification should be handled by the shell, not .env
# Add these manually to your shell profile:
# export PATH=$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin
